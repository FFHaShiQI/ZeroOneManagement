<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hajimi.backend.mapper.GroupMapper">

    <!--根据小组编号查询小组-->
    <select id="getById" resultType="com.hajimi.backend.vo.GroupVo">
        select g.*, s.name seniorName from `group` g left join senior s on g.senior_id = s.id
        where g.id = #{id}
    </select>

</mapper>