<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hajimi.backend.mapper.MemberMapper">

    <!--修改组员信息-->
    <update id="update">
        update member
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="age != null">age = #{age},</if>
            <if test="image != null and image != ''">image = #{image},</if>
            <if test="selfIntro != null">self_intro = #{selfIntro},</if>
            <if test="number != null and number != ''">number = #{number},</if>
            <if test="pos != null">pos = #{pos}</if>
        </set>
        where id = #{id}
    </update>

    <!--根据id查询单个组员的信息-->
    <select id="getById" resultType="com.hajimi.backend.vo.MemberVo">
        select m.*, g.name groupName from member m left join `group` g on m.group_id = g.id
        where m.id = #{id}
    </select>

</mapper>