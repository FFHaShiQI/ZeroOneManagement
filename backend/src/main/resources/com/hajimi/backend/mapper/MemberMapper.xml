<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hajimi.backend.mapper.MemberMapper">

    <!--学员的-->
    <select id="getByUsername" resultType="com.hajimi.backend.entity.Member">
        select id,username,password,name,image,group_id
        from member
        where username = #{username}
    </select>

    <insert id="saveInMember" useGeneratedKeys="true" keyProperty="id">
        insert into member(username,password,name,image,group_id)
        values(#{username},#{password},#{name},#{image},#{groupId})
    </insert>

</mapper>
