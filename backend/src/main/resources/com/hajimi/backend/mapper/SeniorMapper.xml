<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hajimi.backend.mapper.SeniorMapper">

    <!--学长的-->
    <select id="getByUsername" resultType="com.hajimi.backend.entity.Senior">
        select id,username,password,name,image
        from senior
        where username = #{username}
    </select>

    <insert id="saveInSenior" useGeneratedKeys="true" keyProperty="id">
        insert into senior(username,password,name,image)
        values(#{username},#{password},#{name},#{image})
    </insert>

</mapper>
